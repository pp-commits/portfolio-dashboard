generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Holding {
  id            Int      @id @default(autoincrement())
  symbol        String   // e.g., "TCS.NS"
  name          String
  exchange      String
  purchasePrice Float
  quantity      Int
  sector        String
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Transaction {
  id          Int      @id @default(autoincrement())
  amount      Float
  type        String
  category    String
  description String
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
}
